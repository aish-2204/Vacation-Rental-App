APP_ENV=development
APP_NAME=Vacation Rental API
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://vacation:vacation@127.0.0.1:55432/vacation_rental_dev
TEST_DATABASE_URL=postgresql+asyncpg://vacation:vacation@127.0.0.1:55433/vacation_rental_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Blank: generate a temporary process-specific key for local development only.
# For persistent local tokens, generate one with: python3.12 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Outside development/test, an explicit generated key of at least 32 bytes is required.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60

# Media uploads (see docs/media-storage.md).
# local = files go to backend/media-uploads and are served at <API_PUBLIC_BASE_URL>/media.
STORAGE_PROVIDER=local
API_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional override for where stored files are publicly read (CDN, custom domain, ...).
STORAGE_PUBLIC_BASE_URL=
STORAGE_LOCAL_ROOT=media-uploads
UPLOAD_URL_TTL_SECONDS=600
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=209715200
# Azure Blob Storage placeholders: set STORAGE_PROVIDER=azure and pip install -e 'backend[azure]'.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=listing-media
